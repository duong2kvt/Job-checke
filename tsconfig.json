{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "isolatedModules": true
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/pages", "src/components", "src/data", "src/lib"]
}
